{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm ci && npm run build"
  },
  "deploy": {
    "startCommand": "npx serve -s dist/team-task-manager/browser -l ${PORT:-4200}",
    "healthcheckPath": "/",
    "healthcheckTimeout": 120
  }
}
